---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import SubpageHero from '../../components/subpage-hero.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Soporte Técnico y Mantenimiento - XPEEDnet">
  <Navbar />

  <SubpageHero
    title="Soporte Técnico y Mantenimiento"
    description="Mantenemos tus equipos y sistemas funcionando para que tu operación nunca se detenga. Diagnóstico, reparación y mantenimiento preventivo para tu infraestructura."
    accent="text-accent-cyan"
  />

  <main>
    <!-- Reparación de PCs y Notebooks -->
    <section class="bg-bg-primary py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-text-primary font-inter">
              Reparación de PCs y Notebooks
            </h2>
            <p class="text-text-secondary mt-4 font-inter leading-relaxed">
              Diagnóstico y reparación de equipos de escritorio y portátiles. Reemplazo de componentes,
              recuperación de datos y optimización de rendimiento para que tus equipos vuelvan a operar.
            </p>
          </div>
          <div class="bg-bg-secondary p-8 rounded-xl border border-accent-cyan/30">
            <h3 class="text-lg font-bold text-accent-cyan font-inter mb-3">Incluye</h3>
            <ul class="space-y-2">
              <li class="text-text-secondary font-inter flex items-start">
                <span class="text-accent-cyan mr-2">▹</span>Diagnóstico técnico integral
              </li>
              <li class="text-text-secondary font-inter flex items-start">
                <span class="text-accent-cyan mr-2">▹</span>Reparación de hardware
              </li>
              <li class="text-text-secondary font-inter flex items-start">
                <span class="text-accent-cyan mr-2">▹</span>Instalación y configuración de sistemas
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Abonos de Mantenimiento Preventivo -->
    <section class="bg-bg-secondary py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div class="bg-bg-primary p-8 rounded-xl border border-accent-cyan/30 order-2 md:order-1">
            <h3 class="text-lg font-bold text-accent-cyan font-inter mb-3">Incluye</h3>
            <ul class="space-y-2">
              <li class="text-text-secondary font-inter flex items-start">
                <span class="text-accent-cyan mr-2">▹</span>Revisiones programadas
              </li>
              <li class="text-text-secondary font-inter flex items-start">
                <span class="text-accent-cyan mr-2">▹</span>Limpieza y actualizaciones periódicas
              </li>
              <li class="text-text-secondary font-inter flex items-start">
                <span class="text-accent-cyan mr-2">▹</span>Atención prioritaria ante incidentes
              </li>
            </ul>
          </div>
          <div class="order-1 md:order-2">
            <h2 class="text-2xl md:text-3xl font-bold text-text-primary font-inter">
              Abonos de Mantenimiento Preventivo
            </h2>
            <p class="text-text-secondary mt-4 font-inter leading-relaxed">
              Planes de mantenimiento preventivo que detectan y resuelven problemas antes de que
              afecten tu operación. Costo predecible y equipos siempre al día.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Soporte IT para PyMEs -->
    <section class="bg-bg-primary py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-text-primary font-inter">
              Soporte IT para PyMEs
            </h2>
            <p class="text-text-secondary mt-4 font-inter leading-relaxed">
              Soporte técnico remoto y presencial para equipos de trabajo. Resolución ágil de
              incidentes y acompañamiento continuo para que tu negocio no se detenga.
            </p>
          </div>
          <div class="bg-bg-secondary p-8 rounded-xl border border-accent-cyan/30">
            <h3 class="text-lg font-bold text-accent-cyan font-inter mb-3">Incluye</h3>
            <ul class="space-y-2">
              <li class="text-text-secondary font-inter flex items-start">
                <span class="text-accent-cyan mr-2">▹</span>Mesa de ayuda para tus empleados
              </li>
              <li class="text-text-secondary font-inter flex items-start">
                <span class="text-accent-cyan mr-2">▹</span>Soporte remoto y presencial
              </li>
              <li class="text-text-secondary font-inter flex items-start">
                <span class="text-accent-cyan mr-2">▹</span>Protocolos de respuesta ágil
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FinalCTA />
  <Footer />
</Layout>
