---
const navLinks = [
  { name: 'Inicio', href: '#hero' },
  { name: 'Trayectoria', href: '#trayectoria' },
  { name: 'Contacto', href: '#contacto' },
];

const serviceLinks = [
  { name: 'Soporte Técnico', href: '/servicios/soporte-tecnico' },
  { name: 'Infraestructura', href: '/servicios/infraestructura' },
  { name: 'Desarrollo y Automatización', href: '/servicios/desarrollo-automatizacion' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-bg-primary/95 backdrop-blur-sm border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" class="block" aria-label="XPEEDnet - Inicio">
          <img src="/logo.svg" alt="XPEEDnet" width="150" height="40" class="h-8 w-auto md:h-10" />
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-8">
        <a
          href="#hero"
          class="text-text-secondary hover:text-text-primary transition-colors duration-200 font-medium"
        >
          Inicio
        </a>

        <!-- Dropdown Servicios -->
        <div class="relative">
          <button
            type="button"
            id="services-dropdown"
            aria-haspopup="true"
            aria-expanded="false"
            class="flex items-center gap-1 text-text-secondary hover:text-text-primary transition-colors duration-200 font-medium"
          >
            Servicios
            <svg class="w-4 h-4 transition-transform duration-200" id="services-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <div
            id="services-menu"
            class="absolute left-1/2 -translate-x-1/2 mt-3 w-64 bg-bg-secondary rounded-xl border border-white/10 shadow-xl shadow-black/40 py-2 opacity-0 invisible pointer-events-none transition-all duration-200"
          >
            <div class="px-3 pt-1 pb-2">
              {
                serviceLinks.map((service) => (
                  <a
                    href={service.href}
                    class="block px-3 py-2 text-sm text-text-secondary hover:text-text-primary hover:bg-white/5 rounded-lg transition-colors duration-200"
                  >
                    {service.name}
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-text-secondary hover:text-text-primary transition-colors duration-200 font-medium"
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        id="mobile-menu-button"
        aria-label="Abrir menú"
        aria-expanded="false"
        class="md:hidden flex items-center justify-center w-10 h-10 text-text-primary"
      >
        <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden bg-bg-secondary border-t border-white/10 px-4 pt-2 pb-4 hidden"
  >
    <a
      href="#hero"
      class="block py-2 text-text-secondary hover:text-text-primary transition-colors duration-200 font-medium"
    >
      Inicio
    </a>
    <p class="block pt-2 text-text-secondary font-bold text-sm uppercase tracking-wider">Servicios</p>
    {
      serviceLinks.map((service) => (
        <a
          href={service.href}
          class="block pl-3 py-2 text-text-secondary hover:text-text-primary transition-colors duration-200"
        >
          {service.name}
        </a>
      ))
    }
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="block py-2 text-text-secondary hover:text-text-primary transition-colors duration-200 font-medium"
        >
          {link.name}
        </a>
      ))
    }
  </div>
</nav>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  const toggleMobileMenu = (open) => {
    mobileMenu?.classList.toggle('hidden', !open);
    menuIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    mobileMenuButton?.setAttribute('aria-expanded', String(open));
    mobileMenuButton?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  };

  mobileMenuButton?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    toggleMobileMenu(!isOpen);
  });

  const dropdownButton = document.getElementById('services-dropdown');
  const dropdownMenu = document.getElementById('services-menu');
  const chevron = document.getElementById('services-chevron');

  const setDropdown = (open) => {
    dropdownMenu?.classList.toggle('opacity-0', !open);
    dropdownMenu?.classList.toggle('invisible', !open);
    dropdownMenu?.classList.toggle('pointer-events-none', !open);
    chevron?.classList.toggle('rotate-180', open);
    dropdownButton?.setAttribute('aria-expanded', String(open));
  };

  dropdownButton?.addEventListener('click', (event) => {
    event.stopPropagation();
    const isOpen = !dropdownMenu?.classList.contains('invisible');
    setDropdown(!isOpen);
  });

  document.addEventListener('click', () => setDropdown(false));
</script>
