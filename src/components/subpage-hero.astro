---
interface Props {
  title: string;
  description: string;
  accent: string;
}

const { title, description, accent } = Astro.props;
---

<section class="bg-bg-primary pt-32 pb-16 md:pt-40 md:pb-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <a
      href="/#hero"
      class="inline-flex items-center text-text-secondary hover:text-text-primary transition-colors duration-200 font-medium mb-6"
    >
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Volver al inicio
    </a>
    <h1 class={`text-3xl md:text-5xl font-bold text-text-primary leading-tight font-inter ${accent}`}>
      {title}
    </h1>
    <p class="text-lg md:text-xl text-text-secondary mt-6 max-w-2xl font-inter leading-relaxed">
      {description}
    </p>
  </div>
</section>
